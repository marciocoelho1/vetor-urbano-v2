{
  "name": "@vetor-urbano/web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201",
    "prototype:ui": "ng serve --configuration ui-ux-prototype --host 127.0.0.1 --port 4210",
    "lint:prototype": "prettier --check \"prototypes/ui-ux-gallery/*.{ts,html,scss}\" tsconfig.prototype.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:ci": "ng test --watch=false",
    "test:e2e": "playwright test",
    "lint": "prettier --check \"src/**/*.{ts,html,scss}\" public/theme-init.js angular.json package.json playwright.config.ts \"e2e/**/*.ts\"",
    "build:prototype": "ng build --configuration ui-ux-prototype"
  },
  "private": true,
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "gsap": "3.15.0",
    "leaflet": "^1.9.4",
    "maplibre-gl": "6.11.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.0",
    "@angular/cli": "^22.2.0",
    "@angular/compiler-cli": "^22.2.0",
    "@playwright/test": "1.64.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.22",
    "jsdom": "^30.1.1",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2",
    "vitest": "^5.0.3"
  }
